{
  "name": "postorico-reels",
  "private": true,
  "version": "1.0.0",
  "description": "Rendu des reels animés à la charte client (Remotion). Appelé par backend/services/reel_service.py.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ReelBrand out/reel.mp4",
    "build:server": "tsc -p server/tsconfig.json",
    "start:server": "node out-server/main.js"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "4.0.506",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "0.2.2",
    "remotion": "^4.0.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
