# Miroir de .gitignore : la liste explicite de COPY dans le Dockerfile
# s'est fait piéger 2 fois (storage.py puis broll.py/brolls_ai.py oubliés
# -> ModuleNotFoundError en prod) -> COPY . . + ce blocklist à la place,
# pour que tout nouveau module .py soit embarqué automatiquement.

# Données d'exécution (régénérées au runtime, jamais embarquées dans l'image)
jobs/
cache/
music_cache/
emoji_cache/
broll_cache/
__pycache__/
*.pyc

# Secrets locaux (les vraies clés sont des variables d'environnement Railway)
.env

# Scripts standalone antérieurs à l'app FastAPI (submagic_poc5.py reste :
# réutilisé comme module "base" par pipeline.py)
submagic_poc.py
submagic_poc2.py
submagic_poc3.py
submagic_poc4.py
transcribe_only.py
bd.rnnn

# Vidéos/images/exports de test accumulés en itérant sur le POC
*.mp4
*.ass
*.filtergraph
compare_*.jpg
submagic_*.jpg
submagic_*.png
submagic_style_hint.txt
submagic_transcript.txt
nanobanana_test.png
gemini_pick_test.jpg
emoji_test*.png
emoji_test*.ass
emoji_fire_test.png
test_a.jpg
test_b.jpg
test_c.jpg
words-*.json
regen_test.jpg

# Fichiers de dev/CI non nécessaires à l'exécution
.gitignore
.git/
