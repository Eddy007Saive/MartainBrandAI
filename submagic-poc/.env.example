# Variables d'environnement requises pour le déploiement (Railway ou autre).
# En dev local sur cette machine, ces clés sont lues automatiquement depuis
# backend/.env si ces variables ne sont pas définies — inutile de dupliquer
# ici pour tester localement.

ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-v1-...

# Optionnel — Railway définit PORT automatiquement, pas besoin d'y toucher.
# HOST/PORT ne sont utiles qu'en dehors de Railway (autre hébergeur).
# HOST=0.0.0.0
# PORT=8765
