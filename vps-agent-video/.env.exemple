# Copier en /srv/agent-video/.env (chmod 600, propriétaire root). Ne jamais commiter le .env.

# Jeton partagé avec Postorico (AGENT_VIDEO_JETON sur Railway) : openssl rand -hex 32
JETON=

# Clé API Anthropic (console.anthropic.com), facturée au token. Obligatoire avant d'ouvrir aux
# clients : sans elle, Claude Code utilise la connexion de l'abonnement (tests uniquement).
ANTHROPIC_API_KEY=

# Facultatif
# PORT=8787
# HOST=0.0.0.0            # 127.0.0.1 derrière un proxy HTTPS (Caddy)
# MODELE=opus             # ou sonnet (plus rapide, deux fois moins cher)
# BUDGET_USD=8            # coût estimé maximum par montage
# MAX_MINUTES=45
# SIMULTANES=2            # montages en parallèle (VPS 2 cœurs / 8 Go)
# RETENTION_JOURS=7       # fichiers gardés pour les corrections, puis supprimés
# CLAUDE_BIN et PLUGIN_DIR : posés par installer-securite.sh
